---
import { url } from '../../lib/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['All', ...new Set(allPosts.map((p) => p.data.category))];
---

<BaseLayout 
  title="Blog & Field Notes | Robin Saini"
  description="Technical writings and field notes by Robin Saini on data engineering, Snowflake platforms, data for AI agents, and specialty coffee brewing science."
>
  <div class="blog-header-section">
    <div class="container">
      <div class="section-badge-row">
        <span class="badge badge-coffee">Writings &amp; Field Notes</span>
        <span class="badge">Markdown Powered</span>
      </div>
      <h1 class="heading-xl page-title">
        Engineering &amp; <span class="text-gradient-coffee">Extraction Notes</span>
      </h1>
      <p class="page-subtitle">
        Long-form architectural write-ups on Snowflake, PySpark, Model Context Protocol (MCP) servers, data for AI agents, and the physics of pour-over coffee.
      </p>

      <!-- Category Filter Tabs -->
      <div class="filter-bar">
        {categories.map((cat) => (
          <button class={`filter-tab ${cat === 'All' ? 'active' : ''}`} data-category={cat}>
            {cat}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="container blog-content-section">
    <!-- Posts Grid -->
    <div class="blog-grid" id="blog-grid">
      {sortedPosts.map((post) => (
        <article class="card blog-card" data-category={post.data.category}>
          <div class="blog-card-meta">
            <span class="badge badge-coffee">{post.data.category}</span>
            <span class="blog-date font-mono">
              {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
            </span>
          </div>

          <h2 class="heading-sm blog-card-title">
            <a href={url(`/blog/${post.id}`)}>
              {post.data.title}
            </a>
          </h2>

          <p class="blog-card-desc">
            {post.data.description}
          </p>

          <div class="blog-card-tags">
            {post.data.tags.map((tag: string) => (
              <span class="tag-pill font-mono">#{tag}</span>
            ))}
          </div>

          <div class="blog-card-footer font-mono">
            <span>{post.data.readTime || '5 min read'}</span>
            <a href={url(`/blog/${post.id}`)} class="read-link">
              Read Article ➔
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-header-section {
    padding: 4.5rem 0 3rem 0;
    border-bottom: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, rgba(217, 119, 6, 0.04) 0%, transparent 100%);
  }

  .section-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .page-title {
    margin-bottom: 1rem;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1.15rem;
    max-width: 780px;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-tab {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all 0.15s ease;
  }

  .filter-tab.active,
  .filter-tab:hover {
    background: var(--accent-coffee);
    border-color: var(--accent-coffee);
    color: #ffffff;
  }

  .blog-content-section {
    padding: 3.5rem 0 6rem 0;
  }

  .markdown-tip-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: rgba(99, 102, 241, 0.06);
    border-color: rgba(99, 102, 241, 0.25);
    margin-bottom: 2.5rem;
  }

  .tip-icon {
    font-size: 1.5rem;
  }

  .tip-text {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .tip-text strong {
    color: var(--text-primary);
  }

  .tip-text code {
    font-family: var(--font-mono);
    color: var(--accent-ai-light);
    background: var(--bg-tertiary);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .blog-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .blog-date {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .blog-card-title {
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .blog-card-title a:hover {
    color: var(--accent-coffee-light);
  }

  .blog-card-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    flex-grow: 1;
  }

  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .tag-pill {
    font-size: 0.72rem;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .blog-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.775rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.85rem;
    margin-top: 0.5rem;
  }

  .read-link {
    color: var(--text-primary);
    font-weight: 600;
  }

  .read-link:hover {
    color: var(--accent-coffee-light);
  }
</style>

<script is:inline>
  function setupBlogFilters() {
    const tabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.blog-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const cat = tab.getAttribute('data-category');

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'All' || cardCat === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupBlogFilters();
  document.addEventListener('astro:after-swap', setupBlogFilters);
</script>
