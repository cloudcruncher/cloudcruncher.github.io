---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout 
  title={`${post.data.title} | Robin Saini`}
  description={post.data.description}
>
  <article class="post-page">
    <header class="post-header">
      <div class="container container-narrow">
        <a href={url('/blog')} class="back-link font-mono">
          ← Back to All Articles
        </a>

        <div class="post-meta-row">
          <span class="badge badge-coffee">{post.data.category}</span>
          <span class="post-date font-mono">
            {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </span>
          <span class="post-read-time font-mono">• {post.data.readTime || '5 min read'}</span>
        </div>

        <h1 class="heading-lg post-title">{post.data.title}</h1>
        <p class="post-desc-lead">{post.data.description}</p>

        <div class="post-author-box">
          <div class="author-avatar font-mono">RS</div>
          <div class="author-info">
            <span class="author-name">Robin Saini</span>
            <span class="author-title">Lead Data Engineer &amp; AI Data Engineering • London, UK</span>
          </div>
        </div>
      </div>
    </header>

    <div class="post-body">
      <div class="container container-narrow">
        <div class="prose">
          <Content />
        </div>

        <footer class="post-footer">
          <div class="post-tags-row">
            <span class="tags-label font-mono">Tags:</span>
            {post.data.tags.map((tag: string) => (
              <span class="badge">#{tag}</span>
            ))}
          </div>

          <div class="post-author-cta card">
            <h3 class="heading-sm">Have thoughts or questions on this article?</h3>
            <p>
              I love discussing data lakehouses, AI agents, and dial-in coffee recipes. Feel free to connect on <a href="https://linkedin.com/in/robinsaini" target="_blank" rel="noopener noreferrer">LinkedIn</a> or follow my open-source work on <a href="https://github.com/cloudcruncher" target="_blank" rel="noopener noreferrer">GitHub</a>.
            </p>
            <div class="post-cta-buttons">
              <a href={url('/blog')} class="btn btn-outline btn-sm">← More Articles</a>
              <a href={url('/cv')} class="btn btn-primary btn-sm">View Robin's CV</a>
            </div>
          </div>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-page {
    padding-bottom: 6rem;
  }

  .post-header {
    padding: 3.5rem 0 3rem 0;
    border-bottom: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, rgba(217, 119, 6, 0.03) 0%, transparent 100%);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--accent-coffee-light);
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    font-size: 0.825rem;
  }

  .post-date, .post-read-time {
    color: var(--text-muted);
  }

  .post-title {
    margin-bottom: 1.25rem;
    line-height: 1.25;
  }

  .post-desc-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
  }

  .post-author-box {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .author-avatar {
    width: 42px;
    height: 42px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    color: var(--accent-coffee-light);
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .author-title {
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  .post-body {
    padding-top: 3.5rem;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-tags-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tags-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .post-author-cta {
    background: var(--bg-tertiary);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-author-cta p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .post-author-cta a {
    color: var(--accent-ai-light);
    text-decoration: underline;
  }

  .post-cta-buttons {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn-sm {
    padding: 0.45rem 0.85rem;
    font-size: 0.825rem;
  }
</style>
