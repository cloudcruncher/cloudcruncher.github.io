---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/utils';
---

<BaseLayout title="Page not found | Robin Saini" description="This page does not exist.">
  <div class="container not-found">
    <span class="badge badge-data font-mono">404</span>
    <h1 class="heading-lg">Page not found</h1>
    <p>The page you were looking for doesn't exist or has moved.</p>
    <div class="not-found-actions">
      <a href={url('/')} class="btn btn-primary">Back home</a>
      <a href={url('/blog')} class="btn btn-outline">Read the blog</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding: 6rem 0;
    text-align: center;
  }
  .not-found-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
</style>
