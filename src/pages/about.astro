---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoffeeCorner from '../components/CoffeeCorner.astro';
import AgenticLab from '../components/AgenticLab.astro';
import LondonGuide from '../components/LondonGuide.astro';
---

<BaseLayout 
  title="About Robin Saini | Engineering, Agentic AI, Coffee & London Life"
  description="The story of Robin Saini: Lead / Senior Data Engineer in London, specialty coffee brewing enthusiast, agentic harness pioneer, and city explorer."
>
  <div class="about-hero">
    <div class="container">
      <div class="section-badge-row">
        <span class="badge badge-coffee">Biography &amp; Passions</span>
        <span class="badge">Beyond the Resume</span>
      </div>
      <h1 class="heading-xl about-title">
        The Journey: <span class="text-gradient-ai">Pipelines</span>, <span class="text-gradient-ai">Agentic Systems</span>, and <span class="text-gradient-coffee">Specialty Brews</span>.
      </h1>
      <p class="about-intro">
        I'm a London-based Lead / Senior Data Engineer with 15+ years in technology. When I'm not orchestrating 50+ source Snowflake platforms or designing autonomous agent harnesses, you'll find me pulling morning flat whites on my <strong>Sage Barista Pro</strong> &amp; <strong>DF54 flat burrs</strong>, dialing in unimodal pour-overs on my <strong>1Zpresso ZP6 Special</strong> with strictly London-roasted beans, brewing draft beer at home with my <strong>Pinter</strong>, stamping my <strong>London Beer Passport</strong> across microbreweries and historic pubs, or hunting down the city's finest artisan sourdough loaves.
      </p>
    </div>
  </div>

  <div class="container about-body">
    <!-- Story Timeline Section -->
    <section class="story-section">
      <h2 class="heading-lg story-heading">My Engineering Evolution</h2>

      <div class="timeline-grid">
        <div class="card timeline-card">
          <div class="timeline-period font-mono">2011 – 2016</div>
          <h3 class="heading-sm timeline-title">The Foundation: Mainframes &amp; DB2</h3>
          <p class="timeline-desc">
            Started with COBOL and IBM DB2 systems under rigorous ITIL incident and change management. This taught me system resilience, deterministic transaction integrity, and respect for business-critical core ledgers.
          </p>
        </div>

        <div class="card timeline-card">
          <div class="timeline-period font-mono">2016 – 2021</div>
          <h3 class="heading-sm timeline-title">The Shift: Enterprise Cloud Data Lakes</h3>
          <p class="timeline-desc">
            At Lloyds Banking Group (via TCS), led data services teams, built scalable ETL pipelines that reduced load times by 50%, and designed an ML-ready AWS data lake (S3, Glue, EMR, Athena) for data science programmes.
          </p>
        </div>

        <div class="card timeline-card">
          <div class="timeline-period font-mono">2021 – 2025</div>
          <h3 class="heading-sm timeline-title">Modern Lakehouse Scale: NatWest ESG Platform</h3>
          <p class="timeline-desc">
            Led the engineering team delivering NatWest's ESG and climate data platform on Snowflake: 50+ sources, 1TB+/month, cutting batch times by 40% with PySpark and dbt, and slashing data quality issues by 30%.
          </p>
        </div>

        <div class="card timeline-card highlight-timeline">
          <div class="timeline-period font-mono">2025 – Present</div>
          <h3 class="heading-sm timeline-title">The Frontier: Enterprise Agentic AI &amp; Harnesses</h3>
          <p class="timeline-desc">
            Leading data engineering for agentic AI deployments at NatWest. Built reusable MCP servers, automated Pydantic schema validation gates, and cut manual investigation time by over 90% across 300+ daily cases.
          </p>
        </div>
      </div>
    </section>

    <!-- My Core Philosophy -->
    <section class="philosophy-section">
      <div class="card philosophy-card">
        <h2 class="heading-md">How I Think About Engineering</h2>
        <div class="philosophy-grid">
          <div>
            <h4 class="phil-title">1. Determinism Over Vibes</h4>
            <p class="phil-text">
              Whether building an agentic loop or a PySpark aggregation, don't let models or scripts guess. Use typed data contracts, deterministic Python math, and Pydantic schemas.
            </p>
          </div>
          <div>
            <h4 class="phil-title">2. Decouple Tooling with MCP</h4>
            <p class="phil-text">
              Agents should never write ad-hoc database queries. Expose standardized, sandboxed Model Context Protocol servers so multiple agents share clean, audited interfaces.
            </p>
          </div>
          <div>
            <h4 class="phil-title">3. Measure and Observability First</h4>
            <p class="phil-text">
              Track tool-call latency, schema validation failures, and model reasoning drift in Splunk and automated LLM-as-a-judge pipelines.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Deep Dive Components -->
  <AgenticLab />
  <CoffeeCorner />
  <LondonGuide />
</BaseLayout>

<style>
  .about-hero {
    padding: 5rem 0 3.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, rgba(217, 119, 6, 0.04) 0%, transparent 100%);
  }

  .section-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .about-title {
    margin-bottom: 1.25rem;
    max-width: 960px;
  }

  .about-intro {
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 820px;
  }

  .about-body {
    padding: 4rem 0 2rem 0;
  }

  .story-section {
    margin-bottom: 4rem;
  }

  .story-heading {
    margin-bottom: 2rem;
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .timeline-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .timeline-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .highlight-timeline {
    border-color: rgba(99, 102, 241, 0.4);
    background: linear-gradient(180deg, rgba(99, 102, 241, 0.08) 0%, var(--bg-card) 100%);
  }

  .timeline-period {
    font-size: 0.8rem;
    color: var(--accent-coffee-light);
    font-weight: 700;
  }

  .timeline-title {
    color: var(--text-primary);
  }

  .timeline-desc {
    color: var(--text-secondary);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .philosophy-section {
    margin-bottom: 4rem;
  }

  .philosophy-card {
    padding: 2.5rem;
    background: var(--bg-card);
    border-color: rgba(16, 185, 129, 0.3);
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .philosophy-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .phil-title {
    color: var(--text-primary);
    font-size: 1rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .phil-text {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }
</style>
