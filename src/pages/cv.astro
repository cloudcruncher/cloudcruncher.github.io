---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/utils';
import CVSection from '../components/CVSection.astro';
---

<BaseLayout 
  title="Curriculum Vitae & Professional Resume | Robin Saini"
  description="Full CV for Robin Saini: Lead / Senior Data Engineer in London (UK ILR, eligible for SC clearance) delivering 1TB+/mo Snowflake platforms and enterprise agentic AI data engineering. Available for contract at £750/day."
>
  <div class="cv-page-container">
    <div class="container">
      <div class="cv-intro-banner no-print">
        <div>
          <span class="badge badge-data">Executive Resume</span>
          <h1 class="heading-lg cv-page-title">Curriculum Vitae</h1>
          <p class="cv-page-subtitle">
            15+ years in software &amp; data engineering (10+ in data engineering), with the data work in regulated UK banking at NatWest Group and Lloyds Banking Group, providing the trusted data behind enterprise agentic AI. Right to work in the UK (ILR), eligible for SC clearance, contract rate £750/day. <a href={url('/work-with-me')}>Work with me →</a>
          </p>
        </div>
      </div>

      <CVSection />
    </div>
  </div>
</BaseLayout>

<style>
  .cv-page-container {
    padding: 3.5rem 0 6rem 0;
  }

  .cv-intro-banner {
    margin-bottom: 2rem;
  }

  .cv-page-title {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .cv-page-subtitle {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 780px;
    line-height: 1.6;
  }
</style>
