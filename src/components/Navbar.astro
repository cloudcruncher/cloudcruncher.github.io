---
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../lib/utils';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: url('/'), label: 'Home', raw: '/' },
  { href: url('/about'), label: 'About & Passions', raw: '/about' },
  { href: url('/projects'), label: 'GitHub Projects', raw: '/projects' },
  { href: url('/blog'), label: 'Blog & Notes', raw: '/blog' },
  { href: url('/cv'), label: 'CV / Resume', raw: '/cv' },
];
---

<header class="site-header">
  <div class="container header-container">
    <a href={url('/')} class="brand-logo" aria-label="Robin Saini - Home">
      <div class="brand-avatar">
        <span class="avatar-initials">RS</span>
        <span class="status-dot" title="Lead Engineer, London"></span>
      </div>
      <div class="brand-text">
        <span class="brand-name">Robin Saini</span>
        <span class="brand-title">Data & Agentic Systems</span>
      </div>
    </a>

    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <li>
              <a href={link.href} class={`nav-link ${isActive ? 'active' : ''}`}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-actions">
      <a 
        href="https://github.com/cloudcruncher" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="icon-link" 
        aria-label="GitHub @cloudcruncher"
        title="GitHub @cloudcruncher"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>

      <a 
        href="https://linkedin.com/in/robinsaini" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="icon-link" 
        aria-label="LinkedIn Profile"
        title="LinkedIn Profile"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect width="4" height="12" x="2" y="9"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>

      <ThemeToggle />

      <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
        <svg class="menu-open-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg class="menu-close-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    <div class="container mobile-nav-content">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <li>
              <a href={link.href} class={`mobile-nav-link ${isActive ? 'active' : ''}`}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="mobile-meta">
        <span class="badge badge-coffee">☕ Coffee & Pour-Over Enthusiast</span>
        <span class="badge badge-ai">🤖 AI Data Engineer</span>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-avatar {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-initials {
    font-size: 0.85rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent-coffee-light);
    letter-spacing: -0.05em;
  }

  .status-dot {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    background: var(--accent-data);
    border: 2px solid var(--bg-primary);
    border-radius: 50%;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .brand-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
  }

  .nav-link {
    padding: 0.45rem 0.85rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    transition: all 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
  }

  .nav-link.active {
    color: var(--text-primary);
    background: var(--bg-tertiary);
    font-weight: 600;
    border: 1px solid var(--border-subtle);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .icon-link:hover {
    color: var(--text-primary);
    border-color: var(--border-highlight);
    background: var(--bg-card-hover);
  }

  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
  }

  .menu-close-icon {
    display: none;
  }

  .mobile-menu-btn[aria-expanded="true"] .menu-open-icon {
    display: none;
  }

  .mobile-menu-btn[aria-expanded="true"] .menu-close-icon {
    display: block;
  }

  @media (min-width: 768px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .mobile-nav {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    padding: 1.25rem 0;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.6rem 0.75rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-md);
  }

  .mobile-nav-link.active,
  .mobile-nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
  }

  .mobile-meta {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-nav');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.hidden = isExpanded;
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
