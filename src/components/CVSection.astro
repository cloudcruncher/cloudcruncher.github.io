---
// CVSection.astro
import { url } from '../lib/utils';
---

<div class="cv-wrapper">
  <!-- Action Bar (hidden on print) -->
  <div class="cv-action-bar no-print">
    <div class="cv-action-info">
      <span class="badge badge-data">Curriculum Vitae</span>
      <span class="cv-last-updated font-mono">Updated 29 October 2026</span>
    </div>
    <div class="cv-action-buttons">
      <a href={url('/Robin_Saini_CV.docx')} download class="btn btn-primary btn-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download Word (.docx)
      </a>
      <a href={url('/Robin_Saini_CV.pdf')} download class="btn btn-outline btn-sm">
        Download PDF
      </a>
      <a href={url('/Robin_Saini_CV.txt')} download class="btn btn-outline btn-sm font-mono">
        Plain Text (.txt)
      </a>
      <button onclick="window.print()" class="btn btn-outline btn-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect width="12" height="8" x="6" y="14"></rect>
        </svg>
        Print
      </button>
    </div>
  </div>

  <!-- Main CV Document Paper -->
  <article class="cv-document card">
    <!-- Header -->
    <header class="cv-header">
      <h1 class="cv-name">ROBIN SAINI</h1>
      <div class="cv-headline">
        Lead / Principal Data Engineer | Snowflake Data Platforms &amp; Agentic AI | Python &amp; SQL | PySpark | Airflow &amp; dbt
      </div>
      <div class="cv-contact-row font-mono">
        <span>📍 London, UK</span>
        <span>•</span>
        <a href="mailto:robinsaini156@gmail.com">robinsaini156@gmail.com</a>
        <span>•</span>
        <span>+44 7466 201865</span>
        <span>•</span>
        <a href="https://linkedin.com/in/robinsaini" target="_blank" rel="noopener noreferrer">linkedin.com/in/robinsaini</a>
        <span>•</span>
        <a href="https://github.com/cloudcruncher" target="_blank" rel="noopener noreferrer">github.com/cloudcruncher</a>
      </div>
      <div class="cv-status-row font-mono">
        <span>Right to work in the UK (ILR)</span>
        <span>•</span>
        <span>Eligible for SC clearance</span>
      </div>
    </header>

    <section class="cv-section">
      <h2 class="cv-section-title">PROFESSIONAL SUMMARY</h2>
      <p class="cv-summary-text">Lead data engineer in regulated UK banking: 15+ years in software and data engineering, 8+ in data engineering. Hands-on in Python, SQL, Snowflake, PySpark, Airflow and dbt.</p>
      <ul class="cv-bullet-list">
        <li><strong>Now:</strong> lead data engineer for NatWest's enterprise innovation team, taking agentic AI products from proof of concept to production: a complaints investigation agent checked by LLM-as-a-judge evaluations, a GenAI customer due diligence pipeline and a reusable MCP data-access layer.</li>
        <li><strong>Before:</strong> core engineer on a 50+ source, 1TB+/month Snowflake and dbt ESG and climate data platform whose EPC score data product is shown to customers in the NatWest app; Snowflake and PySpark analytics for Retail Decisioning; Teradata and DB2 data warehousing for Lloyds Banking Group (via TCS).</li>
        <li><strong>How I work:</strong> hands-on individual contributor; mentoring junior engineers and setting engineering standards is part of the job.</li>
      </ul>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">KEY SKILLS</h2>
      <div class="cv-skills-grid">
        <div class="cv-skill-item">Data Engineering: Python (advanced), SQL (expert), PySpark / Apache Spark (incl. AWS EMR Serverless), Apache Airflow (AWS MWAA), dbt, StreamSets, batch ELT/ETL at scale</div>
        <div class="cv-skill-item">Data Platforms: Snowflake (architecture, warehouses, Tasks/Streams, UDFs/stored procedures, Time Travel, cloning, clustering, materialised views, performance and cost tuning), PostgreSQL, Teradata, IBM DB2, data modelling; familiar with Hadoop and Hive</div>
        <div class="cv-skill-item">AI Data Engineering: OpenAI / Agents SDK tool calling, Kafka (consumer, familiar), MCP servers and agent tool integration, RAG / retrieval and context pipelines, LangGraph, Pydantic data contracts, LLM-as-a-judge evaluation, AI observability; AI-assisted engineering (Claude Code, Kiro CLI)</div>
        <div class="cv-skill-item">Cloud &amp; DevOps: AWS (S3, Glue, EMR, Athena, SageMaker), GitLab CI/CD, Docker, Git, Splunk; familiar with Terraform (maintains configuration in team repos)</div>
        <div class="cv-skill-item">Quality &amp; Leadership: data quality in regulated environments, data contracts, data quality gates, audit trails and lineage, automated testing, incident management; technical leadership, coaching and mentoring, onshore-offshore delivery, engineering standards, stakeholders from discovery onwards, Agile</div>
      </div>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">PROFESSIONAL EXPERIENCE</h2>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">NatWest Group, London (Hybrid) — Senior Data Engineer - Agentic Systems &amp; LLM Deployment</div>
          <div class="cv-job-dates font-mono">Aug 2025 – Present</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Lead data engineer for all agentic AI products in the enterprise innovation team, from proof of concept to production, including a complaints investigation agent, a complaints decision-assist agent, an LLM-as-a-judge evaluation service and a contact-centre assist programme.</li>
          <li>Complaints AutoInvestigation agent: engineered the data layer for an agent that investigates a complaint across many systems and writes an investigation summary. Built on the OpenAI Agents SDK with a 30-tool registry covering core banking, credit cards, collections and case management, fed by complaints from Kafka, with tools chosen by complaint category. Every source passes data quality checks with auditing and logging, everything the agent receives is logged as facts, and encrypted outputs are stored in PostgreSQL with controls on token usage and made-up answers.</li>
          <li>Customer due diligence AI checks: led data engineering on a GenAI quality-check programme for commercial customer onboarding. Designed and documented a Polars-based ETL pipeline turning onboarding Kafka payloads into structured PostgreSQL datasets for LLM-driven checks, enriched with Companies House data, supporting 300+ applications a day. Built the data-quality checks, data contracts and audit trails, and wrote the handover documentation and operations runbook.</li>
          <li>Designed a reusable MCP server with personal-data safeguards (it returns only small slices of data, only the fields each role may see, and keeps a full audit trail) that multiple agents use with no data-access code of their own, standardising access to core banking, CRM and case-management systems.</li>
          <li>Built RAG / retrieval and context pipelines; traced poor retrieval results back to their source and fixed them (filtering by segment, how many candidates are considered, minimum confidence cut-offs), materially improving relevant-result recall. Cut agent data-hydration latency by keeping connections open and caching responses.</li>
          <li>Built PySpark pipelines on AWS EMR Serverless for model monitoring (model accuracy, LLM token usage and latency), orchestrated by Airflow.</li>
          <li>Introduced Snowflake CI/CD and automated testing for data loaders, and built a Snowflake writer that retries failed writes, taking deployment issues to near zero. Built Splunk observability for agent runs, tool-call performance and decision quality; deployed with GitLab CI/CD and Docker.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">NatWest Group, Edinburgh — Senior Data Engineer - Climate Analytics (ESG Data Platform)</div>
          <div class="cv-job-dates font-mono">Jul 2023 – Aug 2025</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Senior engineer on the team delivering NatWest's Snowflake ESG and climate data platform on a medallion architecture: 50+ internal and external sources and 1TB+ of data a month, for analytics and regulatory reporting.</li>
          <li>Built the layered dbt project (RAW landing, INT integration and history, PRS presentation) with lineage, SCD-2 snapshots for vendor history, and dbt tests and docs as living documentation. Orchestrated on Airflow / AWS MWAA with config-driven pipelines, one per source, and tested builds promoted step by step to production.</li>
          <li>Controlled Snowflake spend by running each dbt model on a right-sized warehouse and using transient tables for rebuildable layers, cutting compute and storage cost.</li>
          <li>Made ingestion metadata-driven (a new source is a config row, not code) and idempotent, with pre-hook guards against duplicate loads and CloudWatch/SNS alerts that fail fast. Sped up batch processing through PySpark and dbt optimisation and reduced data quality incidents with automated monitoring and quality controls.</li>
          <li>Delivered climate data products (emissions, residential EPC certificates and others) used by wealth, commercial and retail teams: the EPC score is shown in the NatWest app and the data feeds climate risk scores, and portfolio views by EPC band support data-backed mortgage and green-loan propositions. Each product has a named data steward, quality metrics, data contracts between producers and consumers, and lineage back to source.</li>
          <li>Delivered production climate risk models with Data Architects and Data Scientists; defined engineering standards and data product frameworks; coached and mentored junior engineers on the platform and the skills they needed.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">NatWest Group, Edinburgh — Senior Data Engineer - Retail Analytics</div>
          <div class="cv-job-dates font-mono">Sep 2021 – Jul 2023</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Engineered enterprise batch pipelines in Python, SQL, Snowflake, PySpark and StreamSets that move data from source to destination for the Retail Data &amp; Analytics Decisioning team, including Customer Lifetime Value analytics, building them to be idempotent and robust.</li>
          <li>Designed Snowflake data models for high-volume retail analytics, using clustering, partitioning and materialised views to speed up queries for Customer Lifetime Value work. Took part in the Teradata-to-Snowflake migration, including moving data marts.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">Tata Consultancy Services (client: Lloyds Banking Group), Manchester &amp; Gurugram — Associate Consultant - Enterprise Data Platform</div>
          <div class="cv-job-dates font-mono">Jun 2019 – Sep 2021</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Moved into the enterprise data platform team to work on Teradata, and joined the data quality management unit, resolving issues flagged by overnight batch pipelines through the UI or the DB2 operational system on the mainframe.</li>
          <li>Worked in an onshore-offshore delivery model, mentoring team members and managing client deliveries for the Lloyds enterprise data platform: Teradata warehouse, reporting applications, other data service applications on SQL Server and Teradata, and data support for analytics teams.</li>
          <li>Worked in an on-premise Teradata, Hadoop, Hive and Python environment; gathered requirements for cloud migration and tried GCP and Dataform as modernisation towards GCP began.</li>
          <li>Supported batch runs and sought performance improvements wherever possible; took part in Teradata upgrades and disaster recovery.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">Tata Consultancy Services (client: Lloyds Banking Group) — Associate Consultant - Customer Information System (DB2 ODS)</div>
          <div class="cv-job-dates font-mono">Feb 2016 – May 2019</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Supported the IBM DB2 operational data store behind the customer information system: managed data quality incidents, including customer profile merge and unmerge issues.</li>
          <li>Worked on data warehousing and big data across the DB2 operational data store, Teradata and Hadoop.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">UST Global, Gurugram &amp; Sopra Steria, Noida — Software Engineer, Mainframe (Senior from 2015)</div>
          <div class="cv-job-dates font-mono">Apr 2011 – Feb 2016</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Trained in mainframe technology, then built and supported COBOL / DB2 systems for a UK retailer and later at UST Global under ITIL processes; prepared designs with business analysts and mentored junior team members.</li>
        </ul>
      </div>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">EDUCATION &amp; CERTIFICATIONS</h2>
      <div class="cv-edu-grid">
        <div>
          <strong>Education:</strong> B.Tech, Computer Science, Gautam Buddh Technical University, India (2006 – 2010)
        </div>
        <div style="margin-top: 0.5rem;">
          <strong>Certifications:</strong> Big Data on AWS, Amazon Web Services (May 2022) • Data Engineering Nanodegree, Udacity (May 2022) • Google Cloud Engineering Specialization, Coursera
        </div>
      </div>
    </section>
  </article>
</div>

<style>
  .cv-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cv-action-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .cv-action-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cv-last-updated {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .cv-action-buttons {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .btn-sm {
    padding: 0.45rem 0.85rem;
    font-size: 0.825rem;
  }

  .cv-document {
    padding: 3rem;
    background: var(--bg-card);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (max-width: 640px) {
    .cv-document {
      padding: 1.5rem;
    }
  }

  .cv-header {
    border-bottom: 2px solid var(--border-subtle);
    padding-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cv-name {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .cv-headline {
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent-data-light);
  }

  .cv-contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    color: var(--text-secondary);
    margin-top: 0.35rem;
  }

  .cv-contact-row a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  .cv-contact-row a:hover {
    color: var(--text-primary);
  }

  .cv-status-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--accent-data-light);
  }

  .cv-section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cv-section-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.35rem;
    margin-bottom: 0.25rem;
  }

  .cv-summary-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .cv-summary-text strong {
    color: var(--text-primary);
  }

  .cv-skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .cv-skill-item strong {
    color: var(--text-primary);
  }

  .cv-bullet-list {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.925rem;
    color: var(--text-secondary);
  }

  .cv-bullet-list li strong {
    color: var(--text-primary);
  }

  .cv-job-block {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cv-job-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.25rem;
  }

  @media (min-width: 640px) {
    .cv-job-header {
      flex-direction: row;
      align-items: baseline;
    }
  }

  .cv-job-role {
    font-weight: 700;
    font-size: 0.975rem;
    color: var(--text-primary);
  }

  .cv-job-dates {
    font-size: 0.825rem;
    color: var(--accent-coffee-light);
    white-space: nowrap;
  }

  .cv-edu-grid {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .cv-edu-grid strong {
    color: var(--text-primary);
  }

  /* Print Specific */
  @media print {
    .cv-document {
      border: none !important;
      padding: 0 !important;
      box-shadow: none !important;
      background: transparent !important;
    }
    .cv-name {
      color: #000000 !important;
    }
    .cv-headline {
      color: #333333 !important;
    }
    .cv-summary-text, .cv-bullet-list, .cv-skills-grid, .cv-edu-grid {
      color: #111111 !important;
      font-size: 0.85rem !important;
    }
    .cv-job-role, .cv-section-title {
      color: #000000 !important;
    }
    .cv-job-dates {
      color: #444444 !important;
    }
  }
</style>
