---
// CVSection.astro
import { url } from '../lib/utils';
---

<div class="cv-wrapper">
  <!-- Action Bar (hidden on print) -->
  <div class="cv-action-bar no-print">
    <div class="cv-action-info">
      <span class="badge badge-data">Curriculum Vitae</span>
      <span class="cv-last-updated font-mono">Updated October 2026</span>
    </div>
    <div class="cv-action-buttons">
      <a href={url('/Robin_Saini_CV.docx')} download class="btn btn-primary btn-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download Word (.docx)
      </a>
      <a href={url('/Robin_Saini_CV.pdf')} download class="btn btn-outline btn-sm">
        Download PDF
      </a>
      <a href={url('/Robin_Saini_CV.txt')} download class="btn btn-outline btn-sm font-mono">
        Plain Text (.txt)
      </a>
      <button onclick="window.print()" class="btn btn-outline btn-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect width="12" height="8" x="6" y="14"></rect>
        </svg>
        Print
      </button>
    </div>
  </div>

  <!-- Main CV Document Paper -->
  <article class="cv-document card">
    <!-- Header -->
    <header class="cv-header">
      <h1 class="cv-name">ROBIN SAINI</h1>
      <div class="cv-headline">
        Lead / Senior Data Engineer | Snowflake | Python &amp; SQL | Spark | Airflow &amp; dbt | Agentic AI Data Engineering
      </div>
      <div class="cv-contact-row font-mono">
        <span>📍 London, UK</span>
        <span>•</span>
        <a href="mailto:robinsaini156@gmail.com">robinsaini156@gmail.com</a>
        <span>•</span>
        <span>+44 7466 201865</span>
        <span>•</span>
        <a href="https://linkedin.com/in/robinsaini" target="_blank" rel="noopener noreferrer">linkedin.com/in/robinsaini</a>
        <span>•</span>
        <a href="https://github.com/cloudcruncher" target="_blank" rel="noopener noreferrer">github.com/cloudcruncher</a>
      </div>
      <div class="cv-status-row font-mono">
        <span>Right to work in the UK (ILR)</span>
        <span>•</span>
        <span>Eligible for SC clearance</span>
        <span>•</span>
        <span>Notice period: 12 weeks</span>
      </div>
    </header>

    <!-- Professional Summary -->
    <section class="cv-section">
      <h2 class="cv-section-title">PROFESSIONAL SUMMARY</h2>
      <p class="cv-summary-text">
        Lead / Senior Data Engineer with <strong>15+ years in software and data engineering</strong> (10+ in data engineering), all in regulated UK banking. Currently lead data engineering for all agentic AI products in NatWest's enterprise innovation team, taking them from proof of concept to production: <strong>over 90% less manual case-handling time</strong> and quality checks on <strong>300+ commercial onboarding applications a day</strong>. Previously led the team that built a <strong>50+ source, 1TB+/month Snowflake ESG and climate data platform</strong>. Hands-on every day in Python, SQL, PySpark, Airflow and dbt, with CI/CD, automated testing and data-quality controls built into delivery. Open to permanent lead roles and contract engagements.
      </p>
    </section>

    <!-- Key Skills -->
    <section class="cv-section">
      <h2 class="cv-section-title">KEY SKILLS</h2>
      <div class="cv-skills-grid">
        <div class="cv-skill-item">
          <strong>Data Engineering:</strong> Python (advanced), SQL (expert), PySpark / Apache Spark (incl. AWS EMR Serverless), Apache Airflow (AWS MWAA), dbt, StreamSets, batch ELT/ETL at scale
        </div>
        <div class="cv-skill-item">
          <strong>Data Platforms:</strong> Snowflake (architecture, clustering, materialised views, performance and cost tuning), PostgreSQL, Teradata, IBM DB2, data lake design, dimensional and analytical modelling
        </div>
        <div class="cv-skill-item">
          <strong>AI Data Engineering:</strong> MCP servers and agent tool integration, RAG / retrieval and context pipelines, OpenAI / Agents SDK, LangGraph, Pydantic data contracts, LLM-as-a-judge evaluation, AI observability; AI-assisted engineering (Kiro CLI, Claude Code)
        </div>
        <div class="cv-skill-item">
          <strong>Cloud &amp; DevOps:</strong> AWS (S3, Glue, EMR, Athena, SageMaker), GitLab CI/CD, Docker, Git, Splunk; Terraform (maintaining configuration), GCP
        </div>
        <div class="cv-skill-item">
          <strong>Quality &amp; Leadership:</strong> data quality gates, audit trails, GDPR-aligned handling, automated testing, incident management; team leadership (up to 5 engineers), mentoring, engineering standards, stakeholders, Agile
        </div>
      </div>
    </section>

    <!-- Selected Impact -->
    <section class="cv-section">
      <h2 class="cv-section-title">SELECTED IMPACT</h2>
      <ul class="cv-bullet-list">
        <li><strong>&gt;90% reduction in manual case-handling time</strong> through agentic decision-support workflows; AI-assisted due-diligence checks on <strong>300+ applications a day</strong>.</li>
        <li><strong>50+ sources, 1TB+ a month</strong> on the Snowflake ESG and climate data platform, delivered as team lead.</li>
        <li><strong>40% faster batches, 30% fewer data quality incidents</strong> (NatWest); <strong>50% lower ETL load times, 45% fewer data errors</strong> (Lloyds).</li>
      </ul>
    </section>

    <!-- Professional Experience -->
    <section class="cv-section">
      <h2 class="cv-section-title">PROFESSIONAL EXPERIENCE</h2>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">NatWest Group, London (Hybrid) — Senior Data Engineer: Agentic Systems &amp; LLM Deployment</div>
          <div class="cv-job-dates font-mono">Aug 2025 – Present</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Lead the data engineering function for all agentic AI products in the enterprise innovation team, from proof of concept to production, including a complaints decision-assist product, an LLM-as-a-judge evaluation service and a contact-centre assist programme.</li>
          <li>Built the data engineering behind decision-support workflows that cut manual case-handling time by over 90%, and an AI-assisted due-diligence capability supporting quality checks on 300+ commercial onboarding applications a day.</li>
          <li>Designed a reusable, PII-guardrailed MCP server (bounded JSON slices, role-based field allow-lists, full audit trail) that multiple agents consume with no data-access code, standardising access to core banking, CRM and case-management systems.</li>
          <li>Built RAG / retrieval and context pipelines; debugged retrieval quality at source (segment filtering, candidate-pool sizing, confidence thresholding), materially improving relevant-result recall. Cut agent data-hydration latency with warmed persistent sessions and response caching.</li>
          <li>Built an LLM-as-a-judge evaluation pipeline (with a batch REST path) scoring model decisions into Snowflake, and PySpark pipelines on AWS EMR Serverless for model monitoring (accuracy, precision, recall, F1, LLM token usage and latency), orchestrated in Airflow.</li>
          <li>Introduced Snowflake CI/CD and automated testing for data loaders; built a resilient Snowflake writer with jittered back-off, reducing deployment issues to near zero.</li>
          <li>Designed data contracts, Pydantic validation, quality gates and audit trails to meet banking and financial-crime compliance standards; built Splunk observability for agent execution and decision quality. Deliver via GitLab CI/CD and Docker.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">NatWest Group, Edinburgh — Senior Data Engineer: Climate Analytics (ESG Data Platform)</div>
          <div class="cv-job-dates font-mono">Jul 2023 – Aug 2025</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Led a team of Data Engineers delivering NatWest's ESG and climate data platform on Snowflake: 50+ internal and external sources, 1TB+ a month, for analytics and regulatory reporting. Layered dbt project (RAW, INT, PRS, presentation) orchestrated by Airflow on AWS MWAA.</li>
          <li>Cut batch processing times by 40% through PySpark and dbt optimisation.</li>
          <li>Reduced data quality incidents by 30% with metadata-driven ingestion (new sources by config, not code), idempotent re-run guards, dbt snapshots and automated dbt tests; cut Snowflake compute cost with per-model warehouse routing and transient tables.</li>
          <li>Delivered production climate risk models with Data Architects and Data Scientists; defined engineering standards and data product frameworks; mentored junior engineers.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">NatWest Group, Edinburgh — Senior Data Engineer: Retail Analytics</div>
          <div class="cv-job-dates font-mono">Sep 2021 – Jul 2023</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Engineered enterprise batch pipelines in Python, SQL, Snowflake, PySpark and StreamSets for the Retail Data &amp; Analytics Decisioning team, including PySpark pipelines for Customer Lifetime Value analytics.</li>
          <li>Designed Snowflake data models for high-volume analytical workloads, tuned with clustering, partitioning and materialised views.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">Tata Consultancy Services (client: Lloyds Banking Group), Manchester &amp; Gurugram — Data Engineer: Enterprise Data Platform</div>
          <div class="cv-job-dates font-mono">Jun 2019 – Sep 2021</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Led a 5-member Data Services team running the Lloyds enterprise data platform: Teradata warehouse, reporting applications and data support for analytics teams.</li>
          <li>Designed and delivered an ML-ready data lake on AWS for data science programmes; supported the IBM DB2 operational data store; ran a Google BigQuery proof of concept for Teradata modernisation.</li>
          <li>Tuned SQL and batch applications to cut CPU consumption; led Teradata upgrades and disaster recovery; gave 24/7 support for business-critical, regulatory and legal applications and resolved a critical production incident in under 12 hours.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">Tata Consultancy Services (client: Lloyds Banking Group) — Enterprise Data Warehouse Engineer</div>
          <div class="cv-job-dates font-mono">Feb 2016 – May 2019</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Built ETL pipelines that cut data load times by 50%; implemented a GDPR-compliant data governance framework that reduced data errors by 45%.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">UST Global, Gurugram — Senior Software Engineer (Mainframe)</div>
          <div class="cv-job-dates font-mono">Apr 2015 – Feb 2016</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Built and supported COBOL / DB2 mainframe applications under ITIL incident, problem and change management; contributed to high-level designs with business analysts and mentored junior team members.</li>
        </ul>
      </div>

      <div class="cv-job-block">
        <div class="cv-job-header">
          <div class="cv-job-role">Sopra Steria, Noida — Software Engineer (Mainframe)</div>
          <div class="cv-job-dates font-mono">Apr 2011 – Mar 2015</div>
        </div>
        <ul class="cv-bullet-list">
          <li>Trained in mainframe technology, then built and supported COBOL / DB2 systems for a UK retailer; prepared detailed designs from business requirements under ITIL processes.</li>
        </ul>
      </div>
    </section>

    <!-- Certifications & Education -->
    <section class="cv-section">
      <h2 class="cv-section-title">EDUCATION &amp; CERTIFICATIONS</h2>
      <div class="cv-edu-grid">
        <div>
          <strong>Education:</strong> B.Tech, Computer Science, Gautam Buddh Technical University, India (2006 – 2010)
        </div>
        <div style="margin-top: 0.5rem;">
          <strong>Certifications:</strong> Big Data on AWS, Amazon Web Services (May 2022) • Data Engineering Nanodegree, Udacity (May 2022) • Google Cloud Engineering Specialization, Coursera
        </div>
      </div>
    </section>
  </article>
</div>

<style>
  .cv-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cv-action-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .cv-action-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cv-last-updated {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .cv-action-buttons {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .btn-sm {
    padding: 0.45rem 0.85rem;
    font-size: 0.825rem;
  }

  .cv-document {
    padding: 3rem;
    background: var(--bg-card);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (max-width: 640px) {
    .cv-document {
      padding: 1.5rem;
    }
  }

  .cv-header {
    border-bottom: 2px solid var(--border-subtle);
    padding-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cv-name {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .cv-headline {
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent-data-light);
  }

  .cv-contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    color: var(--text-secondary);
    margin-top: 0.35rem;
  }

  .cv-contact-row a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  .cv-contact-row a:hover {
    color: var(--text-primary);
  }

  .cv-status-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--accent-data-light);
  }

  .cv-section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cv-section-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.35rem;
    margin-bottom: 0.25rem;
  }

  .cv-summary-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .cv-summary-text strong {
    color: var(--text-primary);
  }

  .cv-skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .cv-skill-item strong {
    color: var(--text-primary);
  }

  .cv-bullet-list {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.925rem;
    color: var(--text-secondary);
  }

  .cv-bullet-list li strong {
    color: var(--text-primary);
  }

  .cv-job-block {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cv-job-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.25rem;
  }

  @media (min-width: 640px) {
    .cv-job-header {
      flex-direction: row;
      align-items: baseline;
    }
  }

  .cv-job-role {
    font-weight: 700;
    font-size: 0.975rem;
    color: var(--text-primary);
  }

  .cv-job-dates {
    font-size: 0.825rem;
    color: var(--accent-coffee-light);
    white-space: nowrap;
  }

  .cv-edu-grid {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .cv-edu-grid strong {
    color: var(--text-primary);
  }

  /* Print Specific */
  @media print {
    .cv-document {
      border: none !important;
      padding: 0 !important;
      box-shadow: none !important;
      background: transparent !important;
    }
    .cv-name {
      color: #000000 !important;
    }
    .cv-headline {
      color: #333333 !important;
    }
    .cv-summary-text, .cv-bullet-list, .cv-skills-grid, .cv-edu-grid {
      color: #111111 !important;
      font-size: 0.85rem !important;
    }
    .cv-job-role, .cv-section-title {
      color: #000000 !important;
    }
    .cv-job-dates {
      color: #444444 !important;
    }
  }
</style>
