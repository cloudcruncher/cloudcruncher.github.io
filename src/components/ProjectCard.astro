---
// ProjectCard.astro
interface Props {
  title: string;
  repo: string;
  category: 'Agentic AI' | 'Lakehouse & Data' | 'Harnesses & Tools';
  description: string;
  architecture: string;
  tags: string[];
  githubUrl: string;
  featured?: boolean;
}

const {
  title,
  repo,
  category,
  description,
  architecture,
  tags,
  githubUrl,
  featured = false,
} = Astro.props;

const categoryBadgeClass = {
  'Agentic AI': 'badge-ai',
  'Lakehouse & Data': 'badge-data',
  'Harnesses & Tools': 'badge-coffee',
}[category] || 'badge';
---

<div class={`card project-card ${featured ? 'project-featured' : ''}`}>
  <div class="project-header">
    <div class="project-meta">
      <span class={`badge ${categoryBadgeClass}`}>{category}</span>
      <span class="project-repo-name font-mono">{repo}</span>
    </div>
    <a 
      href={githubUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="project-gh-btn" 
      aria-label={`View ${title} on GitHub`}
      title="View on GitHub"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
        <path d="M9 18c-4.51 2-5-2-7-2"></path>
      </svg>
      <span class="gh-text">Code</span>
    </a>
  </div>

  <h3 class="heading-sm project-title">
    <a href={githubUrl} target="_blank" rel="noopener noreferrer">
      {title}
    </a>
  </h3>

  <p class="project-desc">{description}</p>

  <div class="project-arch-box">
    <div class="arch-label font-mono">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      Architecture Highlight
    </div>
    <div class="arch-content">{architecture}</div>
  </div>

  <div class="project-tags">
    {tags.map((tag) => (
      <span class="project-pill font-mono">{tag}</span>
    ))}
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1rem;
  }

  .project-featured {
    border-color: rgba(99, 102, 241, 0.4);
    background: linear-gradient(180deg, rgba(99, 102, 241, 0.05) 0%, var(--bg-card) 100%);
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .project-repo-name {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .project-gh-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    transition: all 0.15s ease;
  }

  .project-gh-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-highlight);
    background: var(--bg-card-hover);
  }

  .project-title {
    font-size: 1.2rem;
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .project-title a:hover {
    color: var(--accent-ai-light);
  }

  .project-desc {
    color: var(--text-secondary);
    font-size: 0.925rem;
    line-height: 1.55;
    flex-grow: 1;
  }

  .project-arch-box {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    font-size: 0.825rem;
  }

  .arch-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .arch-content {
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .project-pill {
    font-size: 0.72rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
  }
</style>
