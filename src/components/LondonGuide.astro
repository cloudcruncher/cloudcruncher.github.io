---
// LondonGuide.astro
const mapsUrl = "https://www.google.com/maps/@51.4831098,-0.2938173,14z?authuser=1&entry=ttu&g_ep=EgoyMDI2MDkzMC4wIKXMDSoASAFQAw%3D%3D";
---

<section id="london" class="london-section">
  <div class="container">
    <div class="section-badge-row">
      <span class="badge badge-coffee">📍 London City &amp; Dining Guide</span>
      <span class="badge">Culinary Exploration &amp; Roasteries</span>
    </div>

    <div class="london-header-row">
      <div class="london-header-text">
        <h2 class="heading-lg london-title">
          Exploring London: <span class="text-gradient-coffee">Specialty Counters &amp; Hidden Dining Gems</span>
        </h2>
        <p class="london-desc">
          One of the biggest joys of living in London is the inexhaustible food and coffee scene. When I'm not writing PySpark jobs or configuring MCP harnesses, I love wandering through different London neighborhoods—from West London Thames walks in Kew and Richmond to tucked-away pasta counters in Soho and roasteries in Shoreditch.
        </p>
      </div>
      <div class="maps-cta-box card">
        <div class="maps-icon">🗺️</div>
        <div class="maps-text">
          <div class="maps-title">Robin's London Map</div>
          <div class="maps-sub">Curated spots across London</div>
        </div>
        <a 
          href={mapsUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-coffee btn-sm"
        >
          Open Google Maps ↗
        </a>
      </div>
    </div>

    <div class="london-grid">
      <!-- Card 1: Precision Coffee Counters -->
      <div class="card guide-card">
        <div class="guide-badge badge-coffee">☕ Specialty Coffee Roasters</div>
        <h3 class="heading-sm guide-card-title">Precision Extraction Counters</h3>
        <ul class="guide-list">
          <li>
            <strong>WatchHouse (Bermondsey / St Mary Axe)</strong>
            <span>Extraordinary modern design with rare anaerobic Geisha pour-overs on brew bar.</span>
          </li>
          <li>
            <strong>Workshop Coffee (Fitzrovia &amp; Marylebone)</strong>
            <span>Super clean Scandinavian roast profiles; exceptional morning flat whites.</span>
          </li>
          <li>
            <strong>Rosslyn Coffee (Queen Victoria St / Moorgate)</strong>
            <span>High-volume Australian hospitality in the City with tournament-grade batch brew.</span>
          </li>
          <li>
            <strong>Origin Coffee Roasters (Southwark)</strong>
            <span>Railway arch roastery serving vibrant seasonal single-origins under the brick vaults.</span>
          </li>
        </ul>
      </div>

      <!-- Card 2: West London & Riverside -->
      <div class="card guide-card west-london-card">
        <div class="guide-badge badge-data">🌊 West London &amp; Thames Riverside</div>
        <h3 class="heading-sm guide-card-title">Kew, Richmond &amp; Chiswick</h3>
        <ul class="guide-list">
          <li>
            <strong>Kew Bridge &amp; Brentford Lock</strong>
            <span>Peaceful riverside paths, houseboats, and weekend coffee strolls along the Grand Union Canal.</span>
          </li>
          <li>
            <strong>Richmond upon Thames</strong>
            <span>Historic riverside green, view from Richmond Hill, and specialty spots tucked in the paved lanes.</span>
          </li>
          <li>
            <strong>Chiswick High Road &amp; Chief Coffee</strong>
            <span>Artisan bakeries, independent coffee roasts, and quiet leafy weekend brunches.</span>
          </li>
          <li>
            <strong>Petersham Nurseries</strong>
            <span>Glasshouse cafe and seasonal produce dining under trailing bougainvillea and jasmine.</span>
          </li>
        </ul>
      </div>

      <!-- Card 3: Handcrafted Pasta & Italian -->
      <div class="card guide-card">
        <div class="guide-badge badge-data">🍝 Fresh Pasta &amp; Italian</div>
        <h3 class="heading-sm guide-card-title">Craft &amp; Texture</h3>
        <ul class="guide-list">
          <li>
            <strong>Bancone (Covent Garden &amp; Soho)</strong>
            <span>The famous silk handkerchiefs with walnut butter and confit egg yolk are perfection.</span>
          </li>
          <li>
            <strong>Padella (Borough Market)</strong>
            <span>Pici cacio e pepe and 8-hour beef shin ragu tagliarini, best enjoyed right by the market.</span>
          </li>
          <li>
            <strong>Manteca (Shoreditch)</strong>
            <span>Nose-to-tail Italian with handmade fazzoletti duck ragu and wood-fired focaccia.</span>
          </li>
        </ul>
      </div>

      <!-- Card 4: Open-Fire & Distinctive Flavors -->
      <div class="card guide-card">
        <div class="guide-badge badge-ai">🔥 Wood-Fire &amp; Regional Flavors</div>
        <h3 class="heading-sm guide-card-title">Vibrant Dining Spaces</h3>
        <ul class="guide-list">
          <li>
            <strong>Kiln (Soho)</strong>
            <span>Counter dining over glowing charcoal embers cooking regional northern Thai clay pots.</span>
          </li>
          <li>
            <strong>Brat (Shoreditch)</strong>
            <span>Basque-inspired cooking: wood-fired bread, smoked potatoes, and wild turbot over embers.</span>
          </li>
          <li>
            <strong>Dishoom (King's Cross / Shoreditch)</strong>
            <span>The legendary 24-hour slow-cooked Black Daal and gunpowder potatoes never disappoint.</span>
          </li>
          <li>
            <strong>Roti King (Euston / Battersea)</strong>
            <span>Freshly stretched, flaky roti canai with deeply spiced dahl and kari.</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- The Weekend City Walk Routes -->
    <div class="walks-dual-grid">
      <div class="card walk-card">
        <div class="walk-header">
          <div class="walk-icon">🌊</div>
          <div>
            <span class="walk-tag font-mono">WEST LONDON RECHARGE</span>
            <h3 class="heading-sm walk-title">The Kew-to-Richmond Thames Trail</h3>
          </div>
        </div>
        <p class="walk-text">
          Start at <strong>Kew Bridge</strong> with an espresso ➔ Follow the Thames towpath past Old Deer Park and the historic lock ➔ Stroll across Richmond riverside green ➔ Finish with lunch around Richmond lanes or climb up to Richmond Hill for the legendary Turner view over the Thames valley.
        </p>
      </div>

      <div class="card walk-card">
        <div class="walk-header">
          <div class="walk-icon">🚶‍♂️</div>
          <div>
            <span class="walk-tag font-mono">CENTRAL &amp; EAST LONDON STROLL</span>
            <h3 class="heading-sm walk-title">The Southwark-to-Shoreditch Walk</h3>
          </div>
        </div>
        <p class="walk-text">
          Morning filter coffee at <strong>Origin (Southwark)</strong> ➔ Walk through Borough Market and along the Thames South Bank past Tate Modern ➔ Cross the river towards the historic City alleyways ➔ Wrap up with an afternoon lunch around Spitalfields or Shoreditch, followed by a second pour-over at <strong>Ozone</strong> or <strong>Nude</strong>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .london-section {
    padding: 5rem 0;
    position: relative;
    border-top: 1px solid var(--border-subtle);
  }

  .london-header-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }

  @media (min-width: 860px) {
    .london-header-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .london-header-text {
    max-width: 680px;
  }

  .london-title {
    margin-bottom: 1rem;
  }

  .london-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .maps-cta-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-tertiary);
    border-color: rgba(217, 119, 6, 0.35);
    flex-shrink: 0;
  }

  .maps-icon {
    font-size: 2rem;
  }

  .maps-text {
    display: flex;
    flex-direction: column;
  }

  .maps-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .maps-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .btn-sm {
    padding: 0.45rem 0.85rem;
    font-size: 0.8rem;
  }

  .london-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .london-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .london-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .west-london-card {
    border-color: rgba(6, 182, 212, 0.3);
    background: linear-gradient(180deg, rgba(6, 182, 212, 0.05) 0%, var(--bg-card) 100%);
  }

  .guide-badge {
    align-self: flex-start;
  }

  .guide-card-title {
    color: var(--text-primary);
  }

  .guide-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .guide-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .guide-list strong {
    color: var(--text-primary);
    font-size: 0.925rem;
  }

  .guide-list span {
    color: var(--text-secondary);
    font-size: 0.825rem;
    line-height: 1.5;
  }

  .walks-dual-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .walks-dual-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .walk-card {
    background: linear-gradient(180deg, rgba(217, 119, 6, 0.04) 0%, var(--bg-card) 100%);
    border-color: rgba(217, 119, 6, 0.25);
    padding: 1.75rem 2rem;
  }

  .walk-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .walk-icon {
    font-size: 2rem;
  }

  .walk-tag {
    font-size: 0.72rem;
    color: var(--accent-coffee-light);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .walk-title {
    color: var(--text-primary);
    margin-top: 0.15rem;
  }

  .walk-text {
    color: var(--text-secondary);
    font-size: 0.925rem;
    line-height: 1.65;
  }

  .walk-text strong {
    color: var(--text-primary);
  }
</style>
