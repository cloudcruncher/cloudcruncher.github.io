---
// Hero.astro
import { url } from '../lib/utils';
import PipelineHero from './PipelineHero.astro';
import AgentTerminal from './AgentTerminal.astro';

const rotating = ['AI agents', 'Snowflake platforms', 'regulated banking', 'production LLMs'];
const stack = ['Python', 'SQL', 'Snowflake', 'PySpark', 'Airflow', 'dbt', 'AWS', 'MCP', 'RAG', 'Pydantic', 'LangGraph', 'Claude Code'];
---

<section class="hero-section">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-container">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="hero-badge-row">
          <span class="location-pill"><span class="pulse-dot"></span> London, UK</span>
          <span class="role-pill">Lead / Principal Data Engineer</span>
          <a href={url('/work-with-me')} class="avail-pill">£750/day contract · UK ILR · SC-eligible</a>
        </div>

        <h1 class="heading-xl hero-title">
          I build the data layer behind <br />
          <span class="sr-only">AI agents, Snowflake platforms and regulated banking</span>
          <span aria-hidden="true" class="text-gradient-ai rotator" data-words={JSON.stringify(rotating)}>{rotating[0]}</span><span class="caret" aria-hidden="true"></span>
          <button type="button" class="pause-btn font-mono" id="pause-anim" aria-pressed="false">pause motion</button>
        </h1>

        <p class="hero-description">
          <strong>Robin Saini.</strong> 15+ years in software and data engineering (8+ in data engineering), with the data work in regulated UK banking. I lead the data engineering for agentic AI products at <strong>NatWest Group</strong>, from proof of concept to production, and I design the platforms and data contracts that make agents safe to trust. Before that: a 50+ source, 1TB+/month Snowflake ESG platform whose data product is shown to customers in the NatWest app.
        </p>

        <div class="hero-actions">
          <a href="#architecture" class="btn btn-primary">See the architecture</a>
          <a href={url('/cv')} class="btn btn-outline">Interactive CV</a>
          <a href={url('/work-with-me')} class="btn btn-outline">Work With Me</a>
        </div>

        <div class="stack-row" aria-label="Core stack">
          {stack.map((s) => <span class="chip font-mono">{s}</span>)}
        </div>
      </div>

      <div class="hero-visual">
        <PipelineHero />
        <AgentTerminal />
      </div>
    </div>

    <div class="metrics-grid">
      <div class="metric-card card">
        <div class="metric-number text-gradient-data" data-count="15" data-suffix="+">15+</div>
        <div class="metric-label">Years in engineering</div>
        <div class="metric-sub">8+ in data engineering</div>
      </div>
      <div class="metric-card card">
        <div class="metric-number" data-count="1" data-suffix="TB+/mo">1TB+/mo</div>
        <div class="metric-label">Snowflake ESG platform</div>
        <div class="metric-sub">50+ sources, medallion on dbt + Airflow</div>
      </div>
      <div class="metric-card card">
        <div class="metric-number text-gradient-ai" data-count="90" data-prefix=">" data-suffix="%">&gt;90%</div>
        <div class="metric-label">Less manual case handling</div>
        <div class="metric-sub">Agentic investigation and decision support</div>
      </div>
      <div class="metric-card card">
        <div class="metric-number text-gradient-coffee" data-count="300" data-suffix="+/day">300+/day</div>
        <div class="metric-label">Onboarding checks supported</div>
        <div class="metric-sub">GenAI due-diligence data pipeline</div>
      </div>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Rotating headline word
  const rot = document.querySelector<HTMLElement>('.rotator');
  let paused = false;
  if (rot && !reduce) {
    const words: string[] = JSON.parse(rot.dataset.words || '[]');
    let i = 0;
    setInterval(() => {
      if (paused) return;
      rot.classList.add('swap');
      setTimeout(() => {
        i = (i + 1) % words.length;
        rot.textContent = words[i];
        rot.classList.remove('swap');
      }, 280);
    }, 2600);
  }

  document.getElementById('pause-anim')?.addEventListener('click', (e) => {
    paused = !paused;
    const b = e.currentTarget as HTMLButtonElement;
    b.setAttribute('aria-pressed', String(paused));
    b.textContent = paused ? 'resume motion' : 'pause motion';
    document.documentElement.classList.toggle('motion-paused', paused);
    (document.getElementById('pipe-svg') as unknown as SVGSVGElement | null)?.[paused ? 'pauseAnimations' : 'unpauseAnimations']();
  });

  // Count-up metrics when visible
  const nums = document.querySelectorAll<HTMLElement>('.metric-number[data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        io.unobserve(el);
        const end = Number(el.dataset.count);
        const pre = el.dataset.prefix || '';
        const suf = el.dataset.suffix || '';
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min((t - t0) / 1200, 1);
          el.textContent = pre + Math.round(end * (1 - Math.pow(1 - p, 3))) + suf;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  .hero-section { position: relative; padding: 4rem 0 3rem; overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-subtle) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0.22;
    mask-image: radial-gradient(ellipse 70% 60% at 60% 30%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 60% 30%, #000 20%, transparent 75%);
    animation: drift 40s linear infinite;
  }
  @keyframes drift { to { background-position: 44px 44px; } }

  .hero-container { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 3rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); gap: 3rem; } }

  .hero-copy { display: flex; flex-direction: column; gap: 1.6rem; min-width: 0; }
  .hero-badge-row { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .location-pill, .role-pill, .avail-pill {
    display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; font-family: var(--font-mono);
    padding: 0.3rem 0.75rem; border-radius: var(--radius-full); border: 1px solid var(--border-subtle);
    background: var(--bg-tertiary); color: var(--text-secondary);
  }
  .role-pill { color: var(--accent-ai-light); border-color: var(--accent-ai); background: var(--accent-ai-bg); }
  .avail-pill { color: var(--accent-data-light); border-color: var(--accent-data); background: var(--accent-data-bg); }
  .avail-pill:hover { filter: brightness(1.2); }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-data-light); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); opacity: 0.6; } 0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); } }

  .hero-title { line-height: 1.12; overflow-wrap: anywhere; }
  .rotator { display: inline-block; transition: opacity 0.28s ease, transform 0.28s ease; }
  .rotator.swap { opacity: 0; transform: translateY(8px); }
  .caret { display: inline-block; width: 3px; height: 0.9em; margin-left: 4px; vertical-align: -0.08em; background: var(--accent-ai-light); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .hero-description { color: var(--text-secondary); font-size: 1.05rem; line-height: 1.7; max-width: 60ch; }
  .hero-description strong { color: var(--text-primary); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .stack-row { max-width: 100%; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { font-size: 0.72rem; padding: 0.2rem 0.55rem; border-radius: var(--radius-sm); background: var(--bg-tertiary); border: 1px solid var(--border-subtle); color: var(--text-secondary); }

  .hero-visual { min-width: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .pause-btn { display: block; margin-top: 0.6rem; font-size: 0.68rem; font-weight: 400; letter-spacing: 0; color: var(--text-muted); border: 1px solid var(--border-subtle); border-radius: var(--radius-full); padding: 0.15rem 0.6rem; }
  .pause-btn:hover { color: var(--text-primary); }
  :global(.motion-paused) *, :global(.motion-paused) *::before, :global(.motion-paused) *::after { animation-play-state: paused !important; }

  .metrics-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  @media (min-width: 900px) { .metrics-grid { grid-template-columns: repeat(4, 1fr); } }
  .metric-card { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .metric-number { font-size: clamp(1.6rem, 3.4vw, 2.1rem); font-weight: 800; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .metric-label { font-weight: 600; font-size: 0.92rem; }
  .metric-sub { color: var(--text-muted); font-size: 0.8rem; }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg, .pulse-dot, .caret { animation: none; }
  }
</style>
